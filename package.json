{
  "name": "otsu-library-checker",
  "version": "1.0.0",
  "description": "大津市立図書館の貸出・予約状況をチェックしてSlackに通知するスクリプト",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/tough-cookie": "^4.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
