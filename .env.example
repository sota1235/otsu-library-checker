# 1Password CLI の参照URI (op://<ボールト名>/<アイテム名またはID>/<フィールド名>) を記載する。
# 実行時は `op run --env-file=.env -- <command>` で実値に展開される。

# 図書館アカウント（_1, _2, ... と連番で複数指定できる）
# 通知に表示する名前（省略時: アカウント1）
OTSU_LIBRARY_LABEL_1=
# 大津市立図書館 利用券番号
OTSU_LIBRARY_CARD_NO_1="op://Personal/Otsu Library/card_no"
# 大津市立図書館 パスワード
OTSU_LIBRARY_PASSWORD_1="op://Personal/Otsu Library/password"

# 2人目以降は同様に番号を増やして追加する
# OTSU_LIBRARY_LABEL_2=
# OTSU_LIBRARY_CARD_NO_2="op://Personal/Otsu Library (Kid)/card_no"
# OTSU_LIBRARY_PASSWORD_2="op://Personal/Otsu Library (Kid)/password"

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL="op://Personal/Otsu Library/slack_webhook_url"

# 返却期限の何日前から通知するか（省略時: 7）
# DUE_SOON_DAYS=7
# 返却期限までの残日数がこの値を切ったら @channel を付ける（省略時: 7）
# MENTION_CHANNEL_DAYS=7
# 1にすると取得したHTMLを debug/ ディレクトリに保存する（初回動作確認・トラブルシュート用）
# DEBUG_DUMP_HTML=1
# 1にするとSlackに送信せず標準出力にメッセージを表示する
# DRY_RUN=1
